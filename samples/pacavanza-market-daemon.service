[Unit]
Description=PACAvanza Market Daemon
After=network.target

[Service]
Type=simple
WorkingDirectory=/path/to/pacavanza
ExecStart=/path/to/pacavanza/venv/bin/python3 -m pacavanza.avanza_market_daemon mini-l-omx-ava-468 mini-s-omx-ava-1575 mini-l-sp500-ava-270 mini-s-sp500-ava-330
Restart=always
Environment=PATH=/path/to/pacavanza/venv/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
