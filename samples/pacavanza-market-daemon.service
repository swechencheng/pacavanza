[Unit]
Description=PACAvanza Market Daemon
After=network.target

[Service]
Type=simple
WorkingDirectory=/path/to/pacavanza
ExecStart=/path/to/pacavanza/venv/bin/python3 -m pacavanza.avanza_market_daemon
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
Environment=PATH=/path/to/pacavanza/venv/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
