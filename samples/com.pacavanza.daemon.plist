<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Label</key>
        <string>com.pacavanza.daemon</string>

        <key>ProgramArguments</key>
        <array>
            <string>/path/to/pacavanza/venv/bin/run-pacavanza</string>
        </array>

        <key>RunAtLoad</key>
        <true />

        <!-- KeepAlive true ensures the controller itself is always running -->
        <!-- The controller daemon internally handles 8AM-23PM logic for sub-processes -->
        <key>KeepAlive</key>
        <true/>

        <key>WorkingDirectory</key>
        <string>/path/to/pacavanza</string>

        <key>EnvironmentVariables</key>
        <dict>
            <key>PATH</key>
            <string>/path/to/pacavanza/venv/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
            <key>PYTHONUNBUFFERED</key>
            <string>1</string>
        </dict>

        <key>StandardOutPath</key>
        <string>/tmp/pacavanza.controller.stdout.log</string>
        <key>StandardErrorPath</key>
        <string>/tmp/pacavanza.controller.stderr.log</string>
    </dict>
</plist>
