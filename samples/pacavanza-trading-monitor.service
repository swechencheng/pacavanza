[Unit]
Description=PACAvanza Trading Monitor
After=pacavanza-dashboard
Requires=pacavanza-dashboard

[Service]
Type=simple
WorkingDirectory=/path/to/pacavanza
ExecStart=/path/to/pacavanza/venv/bin/python3 -m pacavanza.trading_monitor
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
Environment=PATH=/path/to/pacavanza/venv/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
