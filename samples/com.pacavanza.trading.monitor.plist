<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Label</key>
        <string>com.pacavanza.trading.monitor.daemon</string>

        <key>ProgramArguments</key>
        <array>
            <string>/path/to/pacavanza/venv/bin/python</string>
            <string>-m</string>
            <string>pacavanza.trading_monitor</string>
        </array>

        <key>RunAtLoad</key>
        <true />

        <key>KeepAlive</key>
        <true />

        <key>WorkingDirectory</key>
        <string>/path/to/pacavanza</string>

        <key>EnvironmentVariables</key>
        <dict>
            <key>PATH</key>
            <string>/path/to/pacavanza/venv/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
            <key>PYTHONUNBUFFERED</key>
            <string>1</string>
        </dict>

        <key>StandardOutPath</key>
        <string>/tmp/pacavanza.trading.monitor.stdout.log</string>
        <key>StandardErrorPath</key>
        <string>/tmp/pacavanza.trading.monitor.stderr.log</string>
    </dict>
</plist>